# Publish only the reviewer package. New root paths are private by default.
/*
!/.gitignore
!/README.md
!/REVIEWER_GUIDE.md
!/LICENSE_NOTES.md
!/Makefile
!/pyproject.toml
!/requirements-lock.txt
!/configs/
!/src/
!/scripts/
!/tests/
!/reports/
!/data/
!/outputs/
!/supplement/

/supplement/*
!/supplement/*.md
!/supplement/*.csv
!/supplement/*.json
!/supplement/*.sha256

/configs/**
!/configs/**/
!/configs/**/*.yaml
!/configs/**/*.yml
/src/**
!/src/**/
!/src/**/*.py
/scripts/**
!/scripts/**/
!/scripts/**/*.py
/tests/**
!/tests/**/
!/tests/**/*.py
/reports/*
!/reports/*.md

/data/*
!/data/manifests/
!/data/splits/
!/data/splits_round1_submitted/
/data/manifests/*
!/data/manifests/*.csv
!/data/manifests/*.parquet
!/data/manifests/*.json
!/data/manifests/*.txt
/data/splits/*
!/data/splits/*.csv
!/data/splits/*.parquet
!/data/splits/*.json
!/data/splits/*.txt
/data/splits_round1_submitted/*
!/data/splits_round1_submitted/*.csv
!/data/splits_round1_submitted/*.parquet
!/data/splits_round1_submitted/*.json
!/data/splits_round1_submitted/*.txt

/outputs/*
!/outputs/metrics/
!/outputs/predictions/
!/outputs/logs/
!/outputs/checkpoints/
!/outputs/error_analysis/
!/outputs/reviewer/
/outputs/metrics/*
!/outputs/metrics/*.csv
!/outputs/metrics/*.json
/outputs/metrics/finalize_log.json
/outputs/metrics/image_cache.json
/outputs/predictions/*
!/outputs/predictions/*.parquet
/outputs/logs/*
!/outputs/logs/*_meta.json
/outputs/checkpoints/*
!/outputs/checkpoints/*_history.json
/outputs/error_analysis/*
!/outputs/error_analysis/error_summary.csv
!/outputs/error_analysis/calibration.json
/outputs/reviewer/*
!/outputs/reviewer/*.csv
!/outputs/reviewer/*.json

# Credentials, environment files, private documents, and runtime artifacts.
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
*.doc
*.docx
*.pdf
*.tex
*.bib
*.zip
*.pt
*.pth
*.onnx
*.onnx.data
*.log
*.part
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
paper-*/
.superpowers/
.claude/
.codex/
